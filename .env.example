# Server-only GoHighLevel configuration. Never prefix these with NEXT_PUBLIC_.
GHL_PRIVATE_INTEGRATION_TOKEN=
GHL_LOCATION_ID=
GHL_CONTINUITY_CALENDAR_URL=

# Server-only Lifeline Guide configuration.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Set only after the production Vercel Firewall rate-limit rule is verified.
GUIDE_WAF_RATE_LIMIT_VERIFIED=

# Optional email summary: signing and service keys stay on the server.
# Use a unique random signing secret of at least 32 characters.
GUIDE_SUMMARY_SIGNING_SECRET=
RESEND_API_KEY=
GUIDE_SUMMARY_FROM=
# Defaults to the firm's published email if omitted.
GUIDE_SUMMARY_RECIPIENT=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Comma-separated exact hostnames allowed by the Turnstile widget.
GUIDE_TURNSTILE_HOSTNAMES=
